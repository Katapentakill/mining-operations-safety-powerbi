# Keep the exact bytes of the CSV fixtures (UTF-8 with BOM, CRLF), so they stay identical to what the pipeline writes.
*.csv   -text
*.txt   -text
# Text files use LF in the repository.
*.md    text eol=lf
*.py    text eol=lf
*.sql   text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.tmdl  text eol=lf
