{
  "name": "Copper Mining",
  "dataColors": [
    "#B8602A",
    "#4F6D8F",
    "#3E8E85",
    "#7A5C8E",
    "#D9B382",
    "#C0392B",
    "#8A8D3F",
    "#A7ADB3"
  ],
  "background": "#FFFFFF",
  "foreground": "#2B2F33",
  "tableAccent": "#B8602A",
  "good": "#3E8E85",
  "neutral": "#D9B382",
  "bad": "#C0392B",
  "maximum": "#B8602A",
  "center": "#D9B382",
  "minimum": "#F3E6D5",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#2B2F33"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#4A5058"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#B8602A"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#2B2F33"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3DED7"
              }
            },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "valueAxis": {
      "*": {
        "gridlineColor": [
          {
            "solid": {
              "color": "#ECE8E1"
            }
          }
        ],
        "labelColor": [
          {
            "solid": {
              "color": "#6B7178"
            }
          }
        ],
        "fontSize": [
          9
        ]
      }
    },
    "categoryAxis": {
      "*": {
        "labelColor": [
          {
            "solid": {
              "color": "#4A5058"
            }
          }
        ],
        "fontSize": [
          9
        ]
      }
    },
    "legend": {
      "*": {
        "labelColor": [
          {
            "solid": {
              "color": "#4A5058"
            }
          }
        ],
        "fontSize": [
          10
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#2B2F33"
              }
            },
            "textSize": 11
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#2B2F33"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F4F1EC"
              }
            },
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#2B2F33"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FAF8F5"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F1EC"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F1EC"
              }
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}