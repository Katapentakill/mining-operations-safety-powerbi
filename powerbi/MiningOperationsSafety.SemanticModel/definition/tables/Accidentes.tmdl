table Accidentes
	lineageTag: 88c5eae8-e42c-4d83-906c-ab4784cf28ee

	measure Accidentes = COUNTROWS(Accidentes)
		formatString: #,0
		displayFolder: 1 Accidentes
		lineageTag: 226ed65c-7698-42ef-82af-d7cacb0dd7e7

	measure 'Lesiones declaradas' = SUM(Accidentes[Lesiones declaradas (registro)])
		formatString: #,0
		displayFolder: 1 Accidentes
		lineageTag: 2438f046-8c89-4e5a-9beb-bbaa2f44247f

	measure Fatalidades = CALCULATE(COUNTROWS(Accidentes), GradoLesion[Es fatalidad] = TRUE())
		formatString: #,0
		displayFolder: 1 Accidentes
		lineageTag: 5d581cb7-4bfc-4fb9-8af4-520fde8cec62

	measure 'Casos con tiempo perdido' = CALCULATE(COUNTROWS(Accidentes), GradoLesion[Con tiempo perdido] = TRUE())
		formatString: #,0
		displayFolder: 1 Accidentes
		lineageTag: 744d31cb-4276-44b8-9792-1ba050895a62

	measure 'Días perdidos' = SUM(Accidentes[Días perdidos (registro)])
		formatString: #,0
		displayFolder: 1 Accidentes
		lineageTag: f9b42c8c-9730-48aa-b338-64b8ddba7ac0

	measure 'Días restringidos' = SUM(Accidentes[Días restringidos (registro)])
		formatString: #,0
		displayFolder: 1 Accidentes
		lineageTag: e80f771b-5675-4dce-8a88-297d07993a25

	measure 'Accidentes de contratistas' = CALCULATE(COUNTROWS(Accidentes), Accidentes[Es contratista] = TRUE())
		formatString: #,0
		displayFolder: 1 Accidentes
		lineageTag: aef5a689-06e1-4e09-a0d4-0abc8cb3b5e5

	measure '% de accidentes de contratistas' = DIVIDE([Accidentes de contratistas], [Accidentes])
		formatString: 0.0%
		displayFolder: 1 Accidentes
		lineageTag: e7e95bcc-dd1e-4e5f-b4c5-fec9b277b304

	measure 'Experiencia promedio en la mina (años)' = AVERAGE(Accidentes[Experiencia en la mina (años)])
		formatString: 0.0
		displayFolder: 1 Accidentes
		lineageTag: adfd19b7-e2ed-4865-9fea-9e3cd231b4ee

	measure 'Accidentes año anterior' = CALCULATE([Accidentes], SAMEPERIODLASTYEAR(Fecha[Fecha]))
		formatString: #,0
		displayFolder: 2 Tiempo
		lineageTag: 9ab53e43-1f3a-4f49-a996-b524ed79ab1b

	measure 'Variación vs año anterior' = DIVIDE([Accidentes] - [Accidentes año anterior], [Accidentes año anterior])
		formatString: 0.0%
		displayFolder: 2 Tiempo
		lineageTag: 265464ab-c22f-4b9e-a5ea-2d419ff03fdf

	measure 'Accidentes acumulados del año' = TOTALYTD([Accidentes], Fecha[Fecha])
		formatString: #,0
		displayFolder: 2 Tiempo
		lineageTag: 2da2e05b-bbfa-4cd8-820d-f330f1a74549

	measure 'Accidentes últimos 12 meses' = CALCULATE([Accidentes], DATESINPERIOD(Fecha[Fecha], MAX(Fecha[Fecha]), -12, MONTH))
		formatString: #,0
		displayFolder: 2 Tiempo
		lineageTag: f765f48c-4e4b-4be3-937b-a91b7e0895ac

	measure 'Casos de lesión (personal propio)' = CALCULATE(COUNTROWS(Accidentes), GradoLesion[Cuenta como lesión] = TRUE(), Accidentes[Es contratista] = FALSE())
		formatString: #,0
		displayFolder: 3 Tasas
		lineageTag: 67125106-2ea3-4b8c-9b5c-8cfa4d041752

	measure 'Tasa de incidencia (por 200.000 h)' =
			VAR Casos = CALCULATE([Casos de lesión (personal propio)], Fecha[Con horas disponibles] = TRUE())
			RETURN DIVIDE(Casos * 200000, [Horas trabajadas])
		formatString: 0.00
		displayFolder: 3 Tasas
		lineageTag: 1fda4460-931a-49be-bb01-0cbe538893b2

	measure 'Tasa de días perdidos (por 200.000 h)' =
			VAR Dias = CALCULATE(SUM(Accidentes[Días perdidos (registro)]), Accidentes[Es contratista] = FALSE(), Fecha[Con horas disponibles] = TRUE())
			RETURN DIVIDE(Dias * 200000, [Horas trabajadas])
		formatString: 0.00
		displayFolder: 3 Tasas
		lineageTag: 04a08a6d-a318-4e9c-9bac-9e94e78c6c8c

	measure 'Accidentes (tabla)' = [Accidentes] + 0
