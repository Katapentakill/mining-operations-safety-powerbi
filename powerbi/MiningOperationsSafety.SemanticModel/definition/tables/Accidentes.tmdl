	measure 'Δ Accidentes (texto)' = VAR one = HASONEVALUE(Fecha[Año]) VAR cur = [Accidentes] VAR prev = CALCULATE([Accidentes], SAMEPERIODLASTYEAR(Fecha[Fecha])) VAR d = cur - prev RETURN IF(NOT one, IF(ISFILTERED(Fecha[Año]), "Varios años", ""), IF(ISBLANK(cur) || ISBLANK(prev) || prev = 0, "Sin año previo", UNICHAR(IF(d > 0, 9650, IF(d < 0, 9660, 9670))) & " " & FORMAT(ABS(DIVIDE(d, prev)), "0.0%", "es-CL") & " vs " & (SELECTEDVALUE(Fecha[Año]) - 1)))
		displayFolder: 3 Variación
		lineageTag: 9e7e11c3-2c22-4158-af6b-2dac78ce2b01

	measure 'Δ Accidentes (color)' = VAR one = HASONEVALUE(Fecha[Año]) VAR d = [Accidentes] - CALCULATE([Accidentes], SAMEPERIODLASTYEAR(Fecha[Fecha])) RETURN IF(NOT one || ISBLANK(d), "#6B7178", IF(d > 0, "#C0392B", IF(d < 0, "#3E8E85", "#6B7178")))
		displayFolder: 3 Variación
		lineageTag: 365e76be-c2f4-47a3-90fe-011410cf1117

	measure 'Δ Incidencia (texto)' = VAR one = HASONEVALUE(Fecha[Año]) VAR cur = [Tasa de incidencia (por 200.000 h)] VAR prev = CALCULATE([Tasa de incidencia (por 200.000 h)], SAMEPERIODLASTYEAR(Fecha[Fecha])) VAR d = cur - prev RETURN IF(NOT one, IF(ISFILTERED(Fecha[Año]), "Varios años", ""), IF(ISBLANK(cur) || ISBLANK(prev) || prev = 0, "Sin año previo", UNICHAR(IF(d > 0, 9650, IF(d < 0, 9660, 9670))) & " " & FORMAT(ABS(DIVIDE(d, prev)), "0.0%", "es-CL") & " vs " & (SELECTEDVALUE(Fecha[Año]) - 1)))
		displayFolder: 3 Variación
		lineageTag: 3ae58791-7a65-419f-8774-a2cb4e4ac75b

	measure 'Δ Incidencia (color)' = VAR one = HASONEVALUE(Fecha[Año]) VAR d = [Tasa de incidencia (por 200.000 h)] - CALCULATE([Tasa de incidencia (por 200.000 h)], SAMEPERIODLASTYEAR(Fecha[Fecha])) RETURN IF(NOT one || ISBLANK(d), "#6B7178", IF(d > 0, "#C0392B", IF(d < 0, "#3E8E85", "#6B7178")))
		displayFolder: 3 Variación
		lineageTag: d6e3fccb-b503-4a1b-9713-2ba8fd72ed5d

	measure 'Δ Fatalidades (texto)' = VAR one = HASONEVALUE(Fecha[Año]) VAR cur = [Fatalidades] VAR prev = CALCULATE([Fatalidades], SAMEPERIODLASTYEAR(Fecha[Fecha])) VAR d = cur - prev RETURN IF(NOT one, IF(ISFILTERED(Fecha[Año]), "Varios años", ""), IF(ISBLANK(cur) || ISBLANK(prev) || prev = 0, "Sin año previo", UNICHAR(IF(d > 0, 9650, IF(d < 0, 9660, 9670))) & " " & FORMAT(ABS(d), "#,0", "es-CL") & " vs " & (SELECTEDVALUE(Fecha[Año]) - 1)))
		displayFolder: 3 Variación
		lineageTag: ee379383-25a6-4480-8bc7-4fcfcdbbe61e

	measure 'Δ Fatalidades (color)' = VAR one = HASONEVALUE(Fecha[Año]) VAR d = [Fatalidades] - CALCULATE([Fatalidades], SAMEPERIODLASTYEAR(Fecha[Fecha])) RETURN IF(NOT one || ISBLANK(d), "#6B7178", IF(d > 0, "#C0392B", IF(d < 0, "#3E8E85", "#6B7178")))
