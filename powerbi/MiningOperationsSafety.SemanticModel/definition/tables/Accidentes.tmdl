	measure 'Δ Contratistas (texto)' = VAR one = HASONEVALUE(Fecha[Año]) VAR cur = [% de accidentes de contratistas] VAR prev = CALCULATE([% de accidentes de contratistas], SAMEPERIODLASTYEAR(Fecha[Fecha])) VAR d = cur - prev RETURN IF(NOT one, IF(ISFILTERED(Fecha[Año]), "Varios años", ""), IF(ISBLANK(cur) || ISBLANK(prev) || prev = 0, "Sin año previo", UNICHAR(IF(d > 0, 9650, IF(d < 0, 9660, 9670))) & " " & FORMAT(ABS(d) * 100, "0.0", "es-CL") & " pp" & " vs " & (SELECTEDVALUE(Fecha[Año]) - 1)))
		displayFolder: 3 Variación
