table Actividad

	column 'Clave de actividad'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: activity_key

	column 'Código de actividad'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: activity_code

	column 'Actividad al momento del accidente'
		dataType: string
		summarizeBy: none
		sourceColumn: activity_desc

	partition Actividad = m
		mode: import
		source =
			let
				Source = Sql.Database(Servidor, Base),
				Vista = Source{[Schema="rpt", Item="dim_activity"]}[Data]
			in
				Vista
