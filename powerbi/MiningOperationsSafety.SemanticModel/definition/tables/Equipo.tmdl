table Equipo

	column 'Clave de equipo'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: equipment_key

	column 'Código de equipo'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: equipment_code

	column 'Equipo minero involucrado'
		dataType: string
		summarizeBy: none
		sourceColumn: equipment_desc

	partition Equipo = m
		mode: import
		source =
			let
				Source = Sql.Database(Servidor, Base),
				Vista = Source{[Schema="rpt", Item="dim_equipment"]}[Data]
			in
				Vista
