table Fecha
	dataCategory: Time

	column 'Clave de fecha'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column Fecha
		dataType: dateTime
		formatString: dd/MM/yyyy
		isKey
		summarizeBy: none
		sourceColumn: calendar_date

	column 'Año'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: calendar_year

	column 'Trimestre (nº)'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: calendar_quarter

	column 'Año-Trimestre'
		dataType: string
		summarizeBy: none
		sourceColumn: year_quarter
		sortByColumn: 'Inicio de trimestre'

	column 'Inicio de trimestre'
		dataType: dateTime
		formatString: dd/MM/yyyy
		isHidden
		summarizeBy: none
		sourceColumn: quarter_start

	column 'Mes (nº)'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: calendar_month

	column Mes
		dataType: string
		summarizeBy: none
		sourceColumn: month_name_es
		sortByColumn: 'Mes (nº)'

	column 'Año-Mes'
		dataType: string
		summarizeBy: none
		sourceColumn: year_month
		sortByColumn: 'Inicio de mes'

	column 'Inicio de mes'
		dataType: dateTime
		formatString: dd/MM/yyyy
		isHidden
		summarizeBy: none
		sourceColumn: month_start

	column 'Día de la semana (nº)'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: weekday_number

	column 'Día de la semana'
		dataType: string
		summarizeBy: none
		sourceColumn: weekday_name_es
		sortByColumn: 'Día de la semana (nº)'

	column 'Año fiscal (MSHA)'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: fiscal_year

	column 'Trimestre fiscal'
		dataType: int64
		summarizeBy: none
		sourceColumn: fiscal_quarter

	column 'Con horas disponibles'
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: has_hours_data

	hierarchy 'Año > Trimestre > Mes'
		level 'Año'
			column: 'Año'
		level 'Año-Trimestre'
			column: 'Año-Trimestre'
		level 'Año-Mes'
			column: 'Año-Mes'

	partition Fecha = m
		mode: import
		source =
			let
				Source = Sql.Database(Servidor, Base),
				Vista = Source{[Schema="rpt", Item="dim_date"]}[Data]
			in
				Vista
