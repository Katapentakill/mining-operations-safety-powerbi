	measure 'Δ Días para corregir (texto)' = VAR one = HASONEVALUE(Fecha[Año]) VAR cur = [Días promedio para corregir] VAR prev = CALCULATE([Días promedio para corregir], SAMEPERIODLASTYEAR(Fecha[Fecha])) VAR d = cur - prev RETURN IF(NOT one, IF(ISFILTERED(Fecha[Año]), "Varios años", ""), IF(ISBLANK(cur) || ISBLANK(prev) || prev = 0, "Sin año previo", UNICHAR(IF(d > 0, 9650, IF(d < 0, 9660, 9670))) & " " & FORMAT(ABS(d), "0.0", "es-CL") & " vs " & (SELECTEDVALUE(Fecha[Año]) - 1)))
		displayFolder: 3 Variación
		lineageTag: c4479648-022a-47c1-a511-ba591fd305ba

	measure 'Δ Días para corregir (color)' = VAR one = HASONEVALUE(Fecha[Año]) VAR d = [Días promedio para corregir] - CALCULATE([Días promedio para corregir], SAMEPERIODLASTYEAR(Fecha[Fecha])) RETURN IF(NOT one || ISBLANK(d), "#6B7178", IF(d > 0, "#C0392B", IF(d < 0, "#3E8E85", "#6B7178")))
		displayFolder: 3 Variación
		lineageTag: 04c8a10f-bf4b-4911-9aed-0a52543158b1

	measure 'Título Infracciones' =
			VAR one = HASONEVALUE(Fecha[Año])
			VAR sel = ISFILTERED(Fecha[Año])
			VAR ss = [% S&S]
			VAR n = ROUND(DIVIDE(1, ss), 0)
			VAR nw = SWITCH(n, 2, "dos", 3, "tres", 4, "cuatro", 5, "cinco", 6, "seis", 7, "siete", FORMAT(n, "0"))
			VAR tn = ADDCOLUMNS(VALUES(Norma[Norma (sección CFR)]), "@i", [Infracciones])
			VAR mx = MAXX(tn, [@i])
			VAR normaTop = MAXX(FILTER(tn, [@i] = mx), Norma[Norma (sección CFR)])
			RETURN
			IF(sel,
				IF(one, "En " & FORMAT(MAX(Fecha[Año]), "0") & ": ", "En los años elegidos: ") & FORMAT([Infracciones], "#,0", "es-CL") & " infracciones, " & FORMAT(ss, "0%", "es-CL") & " significativas y sustanciales",
				"Una de cada " & nw & " infracciones es significativa y sustancial; la norma " & normaTop & " lidera")
		displayFolder: 8 Títulos
		lineageTag: d27b3b3e-4688-411d-8489-daa4f35cea3a

