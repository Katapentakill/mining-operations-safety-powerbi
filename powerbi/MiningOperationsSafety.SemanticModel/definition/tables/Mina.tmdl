table Mina
	lineageTag: 259c6317-4bab-4787-9fcb-4eddf20dfcf3

	measure 'Color por estado' = SWITCH(MAX('Mina'[Estado de la mina]), "Activa", "#B8602A", "Sin producción", "#4F6D8F", "#8F979F")
		displayFolder: 9 Presentación
		lineageTag: 0b931e01-b6af-4b46-a6b2-34bbe2eef113

	measure 'Título Detalle' =
			VAR one = HASONEVALUE('Mina'[Mina])
			VAR sh = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(MAX('Mina'[Mina]), "Freeport-McMoRan ", ""), "Freeport McMoRan ", ""), " Inc.", ""), " Inc", "")
			RETURN
			IF(one, sh, "Las " & FORMAT(DISTINCTCOUNT('Mina'[Clave de mina]), "0") & " minas juntas")
				& ": " & FORMAT([Accidentes] + 0, "#,0", "es-CL") & " accidentes e " & FORMAT([Infracciones] + 0, "#,0", "es-CL") & " infracciones"
		displayFolder: 8 Títulos
		lineageTag: eb5ac230-48e7-4ad8-9d1d-89a062d392db

	measure 'Accidentes (Top 5 minas)' = VAR r = RANKX(ALLSELECTED('Mina'), CALCULATE(COUNTROWS(Accidentes)), , DESC, DENSE) RETURN IF(r <= 5, COUNTROWS(Accidentes))
		formatString: #,0
		displayFolder: 9 Presentación
		lineageTag: e6e123d0-b271-4243-afb0-33b85ebf4ccf

	measure 'Ficha de mina' = VAR one = HASONEVALUE('Mina'[Mina]) VAR sh = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(MAX('Mina'[Mina]), "Freeport-McMoRan ", ""), "Freeport McMoRan ", ""), " Inc.", ""), " Inc", "") RETURN IF(one, sh & " · " & MAX('Mina'[Estado (EE.UU., nombre)]) & " · " & LOWER(MAX('Mina'[Estado de la mina])) & " — " & FORMAT([Accidentes], "#,0", "es-CL") & " accidentes · " & FORMAT([Infracciones], "#,0", "es-CL") & " infracciones · " & FORMAT([Horas trabajadas] / 1000000, "#,0.0", "es-CL") & " millones de horas", "Haz clic en una burbuja del mapa o en una fila de la tabla para ver la ficha de la mina")
		displayFolder: 8 Títulos
		lineageTag: 0f933c1f-2fc2-4c36-bb6c-16bab3d1aca5

