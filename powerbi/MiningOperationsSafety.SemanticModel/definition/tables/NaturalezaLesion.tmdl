table NaturalezaLesion

	column 'Clave de naturaleza'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: nature_injury_key

	column 'Código de naturaleza'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: nature_injury_code

	column 'Naturaleza de la lesión'
		dataType: string
		summarizeBy: none
		sourceColumn: nature_injury_desc

	partition NaturalezaLesion = m
		mode: import
		source =
			let
				Source = Sql.Database(Servidor, Base),
				Vista = Source{[Schema="rpt", Item="dim_nature_injury"]}[Data]
			in
				Vista
