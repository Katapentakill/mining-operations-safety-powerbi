table Ocupacion

	column 'Clave de ocupación'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: occupation_key

	column 'Código de ocupación'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: occupation_code

	column 'Ocupación'
		dataType: string
		summarizeBy: none
		sourceColumn: occupation_desc

	partition Ocupacion = m
		mode: import
		source =
			let
				Source = Sql.Database(Servidor, Base),
				Vista = Source{[Schema="rpt", Item="dim_occupation"]}[Data]
			in
				Vista
